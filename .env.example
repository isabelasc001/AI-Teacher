# Values from the Supabase Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key

# Stripe: Checkout uses the server key; prefer a least-privilege rk_test_ key.
# Never commit the server key or the webhook secret.
STRIPE_SECRET_KEY=your-stripe-restricted-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-local-webhook-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe publishable key is safe for browser use. Hosted Checkout does not
# require it yet, but keep it ready for a future embedded Elements flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true only after Stripe Tax has an active registration for the relevant
# jurisdiction(s) and the product tax codes have been reviewed.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Create these recurring Prices in the same Stripe sandbox as the server key.
STRIPE_PRICE_FAST=price_your_fast_monthly_price
STRIPE_PRICE_FULL=price_your_full_monthly_price

# Resend is configured as Supabase Auth custom SMTP, not in the browser app.
# Use smtp.resend.com / user resend / your Resend API key in Supabase Dashboard.

# Google OAuth is configured in Supabase Authentication > Providers > Google.
# No Google client secret belongs in this browser application's environment.
